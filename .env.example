# ---------------------------------------------------------------------------
# AirCareCrew.shop — environment variables
# Copy this file to .env.local for local development.
# In Vercel, set these under Project Settings -> Environment Variables.
# NEVER commit a real .env or .env.local file.
# ---------------------------------------------------------------------------

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
# Used only in server components / route handlers for admin writes and the
# Stripe webhook handler (bypasses Row Level Security).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Developers -> API keys in the Stripe dashboard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (Developers -> Webhooks -> your endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL, used for Stripe success/cancel redirect URLs, canonical
# links, and sitemap generation. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://aircarecrew.shop
